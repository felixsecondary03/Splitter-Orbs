{
  "expo": {
    "name": "Splitter Orbs",
    "newArchEnabled": true,
    "slug": "splitter-orbs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.base6a785b6e11565e84c8170348.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.base6a785b6e11565e84c8170348.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      ["expo-splash-screen", {
        "backgroundColor": "#0F172A",
        "image": "./assets/images/splash.png",
        "imageWidth": 200,
        "resizeMode": "contain"
      }],
      "expo-status-bar",
      "expo-sharing",
      "expo-navigation-bar"
    ],
    "scheme": "splitterorbs",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}