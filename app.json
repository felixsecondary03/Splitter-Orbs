{
  "expo": {
    "name": "Splitter Orbs",
    "newArchEnabled": true,
    "slug": "splitter-orbs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-jzg.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/app-icon-jzg.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.base6a785b6e11565e84c8170348.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-jzg.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.base6a785b6e11565e84c8170348.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-sharing"
    ],
    "scheme": "splitterorbs",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}